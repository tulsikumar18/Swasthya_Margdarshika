# Application Settings
APP_NAME="Personalized Medical Recommendation System"
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=false
SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_chars

# External AI Provider (Google Gemini)
